# SOLO EJEMPLOS; no guardar credenciales reales en Git
EPE_MOODLE_ORIGIN=https://campus.ejemplo.es
# Dirección HTTPS definitiva, si ya está publicada:
EPE_PUBLIC_URL=https://erp.ejemplo.es
# Paquete original accesible en el servidor:
EPE_BUNDLE_FILE=/ruta/privada/EPE_0446_CURSO_INTEGRADO_U1_A_U7_2026_2027.zip
# O bien un paquete remoto HTTPS con su SHA256 validado:
# EPE_BUNDLE_URL=https://ejemplo.es/descargas/epe-original.zip
# EPE_BUNDLE_SHA256=INTRODUCIR_SHA256_REAL
EPE_INIT_DEMO=0
EPE_PORT=8000
