# SOLO EJEMPLOS; no subir claves ni datos reales.
# IP privada real del contenedor LXC donde vive el ERP:
EPE_BIND_HOST=192.168.1.60
EPE_PORT=8000
EPE_MOODLE_ORIGIN=https://moodle.atreyuediciones.net
# URL externa Cloudflare una vez registrada en el túnel existente:
EPE_PUBLIC_URL=https://erp.ejemplo.es
EPE_BUNDLE_FILE=/root/EPE_0446_CURSO_INTEGRADO_U1_A_U7_2026_2027.zip
# Alternativa: ZIP desde HTTPS verificable con SHA256:
# EPE_BUNDLE_URL=https://ejemplo.es/descargas/epe-original.zip
# EPE_BUNDLE_SHA256=INTRODUCIR_SHA256_REAL
EPE_INIT_DEMO=0
# Opcional para futuras ejecuciones en LXC sin actualizar:
EPE_SYSTEM_UPGRADE=1
