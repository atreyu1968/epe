[Unit]
Description=EPE - ERP Empresa en el Aula (Ubuntu Proxmox LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=epe
Group=epe
WorkingDirectory=/opt/epe/app
EnvironmentFile=/etc/epe/epe.env
ExecStart=/opt/epe/venv/bin/python -m uvicorn runtime.unified:app --host ${EPE_BIND_HOST} --port ${EPE_PORT}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
# LXC no privilegiados: no exigir namespaces de montaje por systemd.

[Install]
WantedBy=multi-user.target
